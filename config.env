#=============#
# 模型选择配置 #
#=============#
# opt: boyue, openai, dashscope, azure, anthropic, general
ACTIVE_MODEL_PROVIDER=boyue


#=============#
# BOYUE API    #  ← 当前主力，统一 endpoint，所有模型通用
#=============#
BOYUE_API_KEY=sk-6Ha24aL4A63gDARCBarMaGd8OqZWH9D6OSKSrrN7ZYEoZRy9
BOYUE_BASE_URL=https://apicz.boyuerichdata.com/v1
BOYUE_MODEL=gpt-4o

# 可选模型（修改 BOYUE_MODEL 即可切换，或在代码中 switch_model）：
# GPT 系列:   gpt-4o | gpt-4o-mini | gpt-4.1 | gpt-4-turbo
# Claude 系列: claude-opus-4-5-20250929 | claude-sonnet-4-5-20250929 | claude-3-5-sonnet-20241022
# Gemini 系列: gemini-2.5-pro | gemini-2.5-flash | gemini-1.5-pro | gemini-1.5-flash
# Qwen 系列:   qwen-vl-max | qwen-vl-plus | qwen2.5-vl-72b-instruct


#=============#
# OpenAI      #  ← 备用，切回时将 ACTIVE_MODEL_PROVIDER 改为 openai
#=============#
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o


#=============#
# Anthropic   #
#=============#
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929


#=============#
# Azure OpenAI #
#=============#
AZURE_API_KEY=your-azure-api-key-here
AZURE_BASE_URL=https://your-resource.openai.azure.com
AZURE_MODEL=gpt-4o
AZURE_API_VERSION=2024-02-15-preview


#=============#
# 阿里云 DashScope #
#=============#
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-vl-max


#=============#
# 自定义代理   #
#=============#
GENERAL_API_KEY=your-general-api-key-here
GENERAL_BASE_URL=http://your-proxy-server/v1
GENERAL_MODEL=gpt-4o